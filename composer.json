{
    "name": "teners/livewire-charts",
    "description": "Livewire Charts",
    "keywords": [
        "teners",
        "livewire-charts"
    ],
    "homepage": "https://github.com/teners/livewire-charts",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Andrés Santibáñez",
            "email": "santibanez.andres@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Emmanuel Adesina",
            "email": "emmanuel@teners.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.2|^7.3|^7.4|^8.0",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^5.0|^6.0|^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^8.0|^9.5.10|^10.5"
    },
    "autoload": {
        "psr-4": {
            "Teners\\LivewireCharts\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teners\\LivewireCharts\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teners\\LivewireCharts\\LivewireChartsServiceProvider"
            ],
            "aliases": {
                "LivewireCharts": "Teners\\LivewireCharts\\LivewireChartsFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
